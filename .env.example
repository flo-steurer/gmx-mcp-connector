# Mailbox identity (never commit a populated .env)
GMX_EMAIL=
GMX_APP_PASSWORD=
# Alternative: GMX_APP_PASSWORD_FILE=/run/secrets/gmx_app_password

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
MCP_API_TOKEN=
# Alternative: MCP_API_TOKEN_FILE=/run/secrets/mcp_api_token
MCP_HOSTNAME=mcp.example.com
MCP_PORT=8000
MCP_BIND_HOST=0.0.0.0
ALLOW_SEND=false
LOG_LEVEL=INFO

IMAP_HOST=imap.gmx.com
IMAP_PORT=993
SMTP_HOST=mail.gmx.com
SMTP_PORT=587
MAIL_TIMEOUT_SECONDS=30

MAX_EMAIL_RESULTS=100
MAX_BODY_CHARS=100000
MAX_ATTACHMENT_BYTES=10485760
MAX_RECIPIENTS=20
MAX_SUBJECT_CHARS=255
MAX_DRAFT_BODY_CHARS=100000
AUDIT_DB_PATH=/data/audit.db

TRAEFIK_ENABLE=false
TRAEFIK_NETWORK=proxy
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt
# Set to the Traefik container/network CIDR in production.
FORWARDED_ALLOW_IPS=127.0.0.1
